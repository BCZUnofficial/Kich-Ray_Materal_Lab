+    lab::EngineTextureMetadata m;check(lab::ReadEngineTextureMetadata(b,m)&&m.hasMaterial&&m.material==2.5f&&m.bumpEnabled&&m.bumpName==name,"THM class weight and custom bump reference must be read");
