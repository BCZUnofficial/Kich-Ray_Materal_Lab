+        const auto smallPatch=lab::MakeSurfaceReliefPatch(source,kind,128,96,.5f,.5f,10.f);
+        const auto largePatch=lab::MakeSurfaceReliefPatch(source,kind,128,96,.5f,.5f,20.f);
