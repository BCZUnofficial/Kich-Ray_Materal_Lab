new file mode 100644
index 0000000..c44f8ac
--- /dev/null
+++ b/src/EngineLighting.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "Core.h"
+#include <algorithm>
+#include <cmath>
+
+namespace lab {
+// SoC R2 r2_rendertarget.cpp s_material / KichR4MaterialLut.h (01b239e).
+// Four quantized slices, not a gloss-dependent, invented Blinn exponent.
+inline Image MakeR2MaterialLut() {
+    Image image;image.w=128;image.h=1024;image.pixels.resize(size_t(image.w)*image.h);
+    auto quantize=[](float v){return uint8_t(std::clamp(int(std::floor(v*255.5f)),0,255));};
+    for(unsigned slice=0;slice<4;++slice)for(unsigned y=0;y<256;++y)for(unsigned x=0;x<128;++x){
+        const float ld=float(x)/127.f;float ls=(float(y)/255.f+.0000001f)*std::pow(ld,1.f/32.f);
+        float d=0,s=0;
+        switch(slice){
+        case 0:d=std::pow(ld,.75f);s=std::pow(ls,16.f)*.5f;break;
+        case 1:d=std::pow(ld,.90f);s=std::pow(ls,24.f);break;
+        case 2:d=ld;s=std::pow(ls*1.01f,128.f);break;
+        case 3:{const float a=std::fabs(1-std::fabs(.05f*std::sin(33.f*ld)+ld-ls));
+            const float b=std::fabs(1-std::fabs(.05f*std::cos(33.f*ld*ls)+ld-ls));
+            const float c=std::fabs(1-std::fabs(ld-ls));d=ld;s=std::pow(std::max({a,b,c}),24.f)*std::pow(ld,1.f/7.f);break;}
+        }
+        if(x==127&&y==255)d=s=1;
+        const uint8_t value=quantize(d);image.pixels[size_t(slice*256+y)*128+x]={value,value,value,quantize(s)};
+    }
+    return image;
+}
+inline float R2SpecularIntensity(V3 color,float glossFactor=1.f) {
+    const float v=std::max(0.f,(color.x+color.y+color.z)/3.f);
+    return glossFactor*(v<1?std::pow(v,2.f/3.f):v);
+}
+}
diff --git a/src/EngineTexture.h b/src/EngineTexture.h
new file mode 100644
index 0000000..6f993ad
--- /dev/null
+++ b/src/EngineTexture.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <utility>
+
+namespace lab {
+struct EngineTextureMetadata {
+    float material=1.f;
+    bool hasMaterial=false,hasBumpMode=false,bumpEnabled=false;
+    std::string bumpName;
+};
+// X-Ray THM is a sequence of little-endian (id, size, payload) chunks.
+// Ignore thumbnail/unknown chunks; reject truncation before installing metadata.
+inline bool ReadEngineTextureMetadata(const std::vector<uint8_t>& bytes,EngineTextureMetadata& output) {
+    if(bytes.empty())return false;
+    auto u32=[&](size_t p){return uint32_t(bytes[p])|(uint32_t(bytes[p+1])<<8)|(uint32_t(bytes[p+2])<<16)|(uint32_t(bytes[p+3])<<24);};
+    EngineTextureMetadata next;
+    for(size_t at=0;at<bytes.size();) {
+        if(bytes.size()-at<8)return false;
+        const uint32_t id=u32(at),size=u32(at+4);at+=8;
+        if(size>bytes.size()-at)return false;
+        if(id==0x0816) {
+            if(size!=8||u32(at)>3)return false;
+            const uint32_t bits=u32(at+4);float weight;std::memcpy(&weight,&bits,4);
+            if(!std::isfinite(weight)||weight<0||weight>1)return false;
+            next.material=float(u32(at))+weight;next.hasMaterial=true;
+        }else if(id==0x0817) {
+            if(size<9)return false;
+            size_t end=at+8;while(end<at+size&&bytes[end])++end;
+            if(end==at+size)return false;
+            next.hasBumpMode=true;next.bumpEnabled=u32(at+4)==2;
+            next.bumpName.assign(reinterpret_cast<const char*>(bytes.data()+at+8),end-at-8);
+        }
+        at+=size;
+    }
+    output=std::move(next);return true;
+}
+}
