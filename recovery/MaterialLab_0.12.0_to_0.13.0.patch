diff --git a/source/tests/AttachmentHistoryTests.cpp b/source/tests/AttachmentHistoryTests.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c948d3b04acea19930e12c4788caa66e03ea3f66
